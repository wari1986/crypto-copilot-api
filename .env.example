ENV=dev
API_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypto_copilot

# Protects sensitive showcase endpoints.
DEMO_API_KEY=change-me

# Structured AI decision demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=60

EXCHANGE=bybit
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
ENABLE_MARKET_DATA_TASKS=false
ENABLE_BACKFILL_ON_STARTUP=false
WS_ORDERBOOK_LEVELS=50
BACKFILL_LOOKBACK_DAYS=30

ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
SOLANA_RPC_URL=
